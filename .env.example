# ==============================================================================
# Environment Configuration Template
# Duplicate this file to '.env' and fill in your actual API keys.
# DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# Groq API Key (Fast inference using Qwen / Llama models)
# Get your key at: https://console.groq.com/keys
groq_api_key="your_groq_api_key_here"

# Tavily API Key (Real-time web search optimized for AI agents)
# Get your key at: https://tavily.com/
tavily_api_key="your_tavily_api_key_here"

# WeatherStack API Key (Live global meteorological telemetry)
# Get your key at: https://weatherstack.com/
weather_api_key="your_weatherstack_api_key_here"

# OpenAI API Key (Optional: only needed if using ChatOpenAI)
# Get your key at: https://platform.openai.com/api-keys
open_api_key="your_openai_api_key_here"
